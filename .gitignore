# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.installed.cfg
dist/
sdist/
.venv/
venv/
env/
.python-version

# Holds the pristine header while a C++ mutation campaign runs, so a run killed
# before its restore can be repaired by the next one. Present only mid-campaign.
.mutation-cpp-interrupted.json

# --- Test / type / lint caches ----------------------------------------------
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.gcda
*.gcno
*.gcov

# --- CMake / native build ----------------------------------------------------
build/
# Build trees beside build/, such as the build-tests tree determinism.yml
# configures. The CMake presets build under build/ itself.
build-*/
_skbuild/
CMakeUserPresets.json
compile_commands.json
*.o
*.obj
*.a
*.lib
*.exp
*.ilk
*.pdb

# Built extension modules land in the package tree; never commit them.
src/tfidf_stability/_native/*.pyd
src/tfidf_stability/_native/*.so
src/tfidf_stability/_native/*.dylib

# --- Data --------------------------------------------------------------------

# MovieLens may NOT be redistributed (see data/README.md). Fetched, never committed.
data/raw/
data/interim/
data/processed/
data/external/
!data/README.md
!data/assets/
!data/lexicon/

# Figures are committed: reports/text/main.tex embeds them. matplotlib stamps its
# version into every PNG, so compare a regenerated figure by the result digest
# stamped on it, not by its bytes.
# Rationale: docs/engineering_notes.md#figures-committed

reports/*.csv
!reports/text/

# The experiment JSON is committed, so every figure and quoted number has its
# data in the tree. Each file carries its result digest and the provenance of
# the run that produced it, so a reader can regenerate it and compare.

# --- LaTeX -------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
reports/text/*.pdf

# --- Notebooks ---------------------------------------------------------------
.ipynb_checkpoints/

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
