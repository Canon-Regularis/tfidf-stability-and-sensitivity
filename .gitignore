# --- CMake / native build ----------------------------------------------------
build/
_skbuild/
CMakeUserPresets.json
compile_commands.json
*.o
*.obj
*.a
*.lib
*.exp
*.ilk
*.pdb

# Built extension modules land in the package tree; never commit them.
src/tfidf_stability/_native/*.pyd
src/tfidf_stability/_native/*.so
src/tfidf_stability/_native/*.dylib

# --- Data --------------------------------------------------------------------
# MovieLens may NOT be redistributed (see data/README.md). Fetched, never committed.
data/raw/
data/interim/
data/processed/
data/external/
!data/README.md
!data/assets/
!data/lexicon/

# Figures are renderings and stay out of the tree: they are reproducible from the
# JSON below by `python scripts/make_figures.py`, and matplotlib stamps its own
# version into every PNG, so committing them would make the bytes depend on the
# plotting library rather than on the result.
reports/figures/
reports/*.csv
!reports/text/

# The experiment JSON *is* committed, deliberately. A figure or a quoted number
# whose underlying data is absent from the tree is an assertion nobody can check,
# which is the one thing this repository is built not to be. Each file carries
# its own result digest and the provenance of the run that produced it, so a
# reader can regenerate it and compare rather than take it on trust.

